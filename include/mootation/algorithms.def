// ============================================================================
// The list of public algorithms, as an X-macro.
//
//   MOOTATION_ALG(key, IndividualType, CoreTemplate)
//
// Adding an algorithm to the library means adding exactly one line here; every
// test that iterates over "all algorithms" then picks it up automatically.
// Include this file with MOOTATION_ALG defined, then #undef it.
// ============================================================================

// ── Pareto-dominance & diversity ────────────────────────────────────────────
MOOTATION_ALG(nsga2,      NSGAII_Individual,    NSGAIICore)
MOOTATION_ALG(spea2,      SPEA2_Individual,     SPEA2Core)
MOOTATION_ALG(spea2_sde,  SPEA2SDE_Individual,  SPEA2SDECore)
MOOTATION_ALG(grea,       GrEA_Individual,      GrEACore)
MOOTATION_ALG(vaea,       VaEA_Individual,      VaEACore)
MOOTATION_ALG(agemoea,    AGEMOEA_Individual,   AGEMOEACore)
MOOTATION_ALG(etea,       NSGAII_Individual,    ETEACore)

// ── Reference-point (NSGA-III family) ───────────────────────────────────────
MOOTATION_ALG(nsga3,      NSGAIII_Individual,   NSGAIIICore)
MOOTATION_ALG(a_nsga3,    ANSGA3_Individual,    ANSGA3Core)
MOOTATION_ALG(theta_dea,  ThetaDEA_Individual,  ThetaDEACore)
MOOTATION_ALG(ar_moea,    ARMOEA_Individual,    ARMOEACore)

