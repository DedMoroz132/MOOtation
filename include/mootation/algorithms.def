MOOTATION_ALG(sms_m2m,    NSGAII_Individual,    SMSM2MCore)
MOOTATION_ALG(moead_ds,   NSGAII_Individual,    MOEADDSCore)
MOOTATION_ALG(rd_emo,     NSGAII_Individual,    RDEMOCore)
MOOTATION_ALG(aprd,       NSGAII_Individual,    APRDCore)
MOOTATION_ALG(liu_gu2011, NSGAII_Individual,    LiuGu2011Core)
