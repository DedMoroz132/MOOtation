#
# Writes OUT with the SHA-256 of an external problems' folder's sources (task
# 24, §24.7.1; engine/CMakeLists.txt), for every run's meta.json (external.
# sources_sha256): the files *.cpp, *.hpp, *.h and *.cmake under DIR, sorted
# by their paths relative to it, one line "<path> <sha256 of the file>" each,
# and the SHA-256 of those lines. problems.toml is not among them: it is read
# when the engine starts, and each row's checksum is written beside.
#
#   cmake -DDIR=<folder> -DOUT=<header> -P external_stamp.cmake
#
# Run on every build, as python/git_stamp.cmake is: an edited source must not
# carry the previous stamp. The header is rewritten only when its content
# changes.

file(GLOB_RECURSE files RELATIVE "${DIR}" "${DIR}/*.cpp" "${DIR}/*.hpp" "${DIR}/*.h" "${DIR}/*.cmake")
list(SORT files)
set(lines "")
foreach(f IN LISTS files)
    file(SHA256 "${DIR}/${f}" h)
    string(APPEND lines "${f} ${h}\n")
endforeach()
string(SHA256 all "${lines}")
list(LENGTH files n)
set(text "// Generated by engine/external_stamp.cmake at build time. Do not edit.\n#define MOOTATION_EXTERNAL_SOURCES_SHA256 \"${all}\"\n#define MOOTATION_EXTERNAL_SOURCES_COUNT ${n}\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
