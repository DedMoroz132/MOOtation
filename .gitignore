# Generated by tools/amalgamate.py. Not committed on purpose: it is ~1.4 MB and
# a stale copy is worse than none. CI regenerates and compiles it every run.
mootation_single.hpp

# --- Run artefacts of the TOML layer ---
# scratch is per worker and overwritten; the journal is per run and appended.
# Both are outputs of a run, never inputs to one, so neither belongs in git —
# and scratch in particular is where meshes and VTU files land.
scratch/
python/examples/scratch/
python/examples/results/

# --- Compiled Python extension ---
# CMake builds mootation._core straight into python/mootation/ so the source
# tree is importable after a build with no copy step. That convenience means
# the artefact sits inside a source directory, where it would otherwise be
# committed — a platform-specific binary in a source repository.
*.pyd
python/mootation/_core*.so
python/mootation/_core*.pyd
_skbuild/
wheelhouse/
